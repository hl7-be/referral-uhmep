     fhir:Narrative.status [ fhir:value "extensions" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ServiceRequest example-drp-telemonitoring-chronic-heart-failure</b></p><a name=\"example-drp-telemonitoring-chronic-heart-failure\"> </a><a name=\"hcexample-drp-telemonitoring-chronic-heart-failure\"> </a><div style=\"display: inline-block; background-color: #fbffeb; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-ereferral-servicerequest-telemonitoring.html\">eReferralServiceRequestTelemonitoring</a></p></div><p><b>BeValidityPeriod</b>: 2026-05-22 --&gt; 2026-11-22</p><blockquote><p><b>Telemonitoring plan</b></p><ul><li>parameter: <span title=\"Codes:{http://snomed.info/sct 27113001}\">Body weight (observable entity)</span></li><li>baseline: <a href=\"Observation-example-telemonitoring-reference-weight.html\">Observation Body weight</a></li><li>change: 2 kg<span style=\"background: LightGoldenRodYellow\"> (Details: UCUM  codekg = 'kg')</span>/3 d<span style=\"background: LightGoldenRodYellow\"> (Details: UCUM  coded = 'd')</span></li><li>change: -2 kg<span style=\"background: LightGoldenRodYellow\"> (Details: UCUM  codekg = 'kg')</span>/3 d<span style=\"background: LightGoldenRodYellow\"> (Details: UCUM  coded = 'd')</span></li></ul></blockquote><blockquote><p><b>Telemonitoring plan</b></p><blockquote><p><b>url</b></p>parameter</blockquote><p><b>value</b>: <span title=\"Codes:{http://snomed.info/sct 271649006}\">Systolic blood pressure (observable entity)</span></p><p><b>range</b>: 160-?</p><blockquote><p><b>url</b></p>threshold</blockquote><p><b>range</b>: ?-90</p><blockquote><p><b>url</b></p>threshold</blockquote></blockquote><blockquote><p><b>Telemonitoring plan</b></p><blockquote><p><b>url</b></p>parameter</blockquote><p><b>value</b>: <span title=\"Codes:{http://snomed.info/sct 271650006}\">Diastolic blood pressure (observable entity)</span></p><p><b>range</b>: 100-?</p><blockquote><p><b>url</b></p>threshold</blockquote><p><b>range</b>: ?-60</p><blockquote><p><b>url</b></p>threshold</blockquote></blockquote><blockquote><p><b>Telemonitoring plan</b></p><blockquote><p><b>url</b></p>parameter</blockquote><p><b>value</b>: <span title=\"Codes:{http://snomed.info/sct 364075005}\">Heart rate (observable entity)</span></p><p><b>range</b>: 110-?</p><blockquote><p><b>url</b></p>threshold</blockquote><p><b>range</b>: ?-50</p><blockquote><p><b>url</b></p>threshold</blockquote></blockquote><blockquote><p><b>Telemonitoring plan</b></p><blockquote><p><b>url</b></p>parameter</blockquote><p><b>value</b>: <span title=\"Codes:{http://snomed.info/sct 250768007}\">Pulmonary artery systolic pressure (observable entity)</span></p><p><b>range</b>: 50-?</p><blockquote><p><b>url</b></p>threshold</blockquote><p><b>range</b>: ?-10</p><blockquote><p><b>url</b></p>threshold</blockquote></blockquote><blockquote><p><b>Telemonitoring plan</b></p><blockquote><p><b>url</b></p>parameter</blockquote><p><b>value</b>: <span title=\"Codes:{http://snomed.info/sct 250769004}\">Pulmonary artery diastolic pressure (observable entity)</span></p><p><b>range</b>: 30-?</p><blockquote><p><b>url</b></p>threshold</blockquote><p><b>range</b>: ?-5</p><blockquote><p><b>url</b></p>threshold</blockquote></blockquote><p><b>status</b>: Active</p><p><b>intent</b>: Order</p><p><b>category</b>: <span title=\"Codes:{http://snomed.info/sct 394579002}\">Cardiology</span>, <span title=\"Codes:{https://www.ehealth.fgov.be/standards/fhir/terminology/CodeSystem/be-cs-prescription-type telemonitoring-chronic-heart-failure}\">telemonitoring-chronic-heart-failure</span></p><p><b>code</b>: <span title=\"Codes:{http://snomed.info/sct 879780004}\">Telehealth monitoring for chronic heart failure</span></p><p><b>subject</b>: Identifier: <a href=\"https://www.ehealth.fgov.be/standards/fhir/core/2.1.2/NamingSystem-be-ssin.html\" title