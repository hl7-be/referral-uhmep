       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example: Annex 81 - Preparing medication (proposal)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Example of an Annex 81 ServiceRequest proposal for preparing medication.\n\nInputs and values used in this example:\n- Profile: be-annex-81\n- Intent: proposal\n- Prescription type: medication-prefill-preparation-appendix-81\n- Procedure code (SNOMED): 385796006\n- Validity period: 2026-02-18 - 2027-02-18\n- Requester role: nurse (PractitionerRole/67120919457-NURSE)\n- Indications (reasonCode - 13 SNOMED codes):\n  * 1290542000\n  * 129834002\n  * 271299001\n  * 275928001\n  * 359748005\n  * 448176008\n  * 62014003\n  * 708014007\n  * 1137439008\n  * 211071000172100\n  * 211101000172107\n  * 397540003\n  * 52448006" ] ;
