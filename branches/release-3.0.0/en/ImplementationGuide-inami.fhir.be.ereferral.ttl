       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example: Bloodletting" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Example of therapeutic bloodletting including quantity.\n\nInputs and values used in this example:\n- Prescription type: bloodletting\n- Procedure code (SNOMED): 127606004\n- Quantity: 300 mL\n- Validity start date: 2026-02-18\n- Timing:\n  * boundsDuration: 1 week\n  * count: 3\n  * frequency: 3\n  * period: 1 week\n- Medical reason (SNOMED): 404684003\n- Notes:\n  * medical-reason" ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
