         fhir:value "https://www.riziv-inami.be/standards/fhir/ereferral/StructureDefinition/ereferral-annex-81" ;
         fhir:link <https://www.riziv-inami.be/standards/fhir/ereferral/StructureDefinition/ereferral-annex-81>
       ]
