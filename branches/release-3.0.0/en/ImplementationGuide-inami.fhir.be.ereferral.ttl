       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://www.riziv-inami.be/standards/fhir/ereferral/ServiceRequest/example-pss-radiology-scenario-04> ;
         fhir:Reference.reference [ fhir:value "ServiceRequest/example-pss-radiology-scenario-04" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "PSS radiology scenario 04" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Example of a diagnostic imaging prescription.\n\nInputs and values used in this example:\n- Patient: Jeanne Darc, female, 20 years old, currently pregnant\n- Indication: new-onset headaches during pregnancy\n- Selected examination: non-contrast CT of the head\n- Procedure code (SNOMED): 383371000119108\n- Initially predefined examination: MR angiography of the head with or without IV contrast\n- Clinical context from Excel: new headaches during pregnancy; no prior chronic headache, migraine, trauma, neurological disorder or known allergies; assess blood pressure, preeclampsia and neurological warning signs\n\nFictitious completions (not specified in Excel): date of birth 2006-04-12, PSS identifier PSS-RAD-004, prescription and validity dates, requester, ambulatory track and routine priority; no implants, diabetes, metallic debris or renal dysfunction and no other safety concern beyond the documented pregnancy. Fictitious examination rationale: the prescriber selects non-contrast head CT for this illustrative scenario; this is not clinical guidance.\nClinical context is represented by encrypted placeholders in patientCondition.text and note.text; date of birth and sex at birth remain encrypted. Placeholders are illustrative, not real encrypted patient data. Procedure coding follows Exam List processed.xlsx." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://www.riziv-inami.be/standards/fhir/ereferral/StructureDefinition/ereferral-servicerequest-diagnosticimaging" ;
         fhir:link <https://www.riziv-inami.be/standards/fhir/ereferral/StructureDefinition/ereferral-servicerequest-diagnosticimaging>
       ]
