       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://www.riziv-inami.be/standards/fhir/ereferral/ServiceRequest/example-pss-radiology-scenario-01> ;
         fhir:Reference.reference [ fhir:value "ServiceRequest/example-pss-radiology-scenario-01" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "PSS radiology scenario 01" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Example of a diagnostic imaging prescription.\n\nInputs and values used in this example:\n- Patient: Henry Dutronc, male, 41 years old\n- Indication: progressive shortness of breath, orthopnea, dry cough and suspected pulmonary edema\n- Selected examination: chest X-ray\n- Procedure code (SNOMED): 399208008\n- Initially predefined examination: chest CT with IV contrast\n- Clinical context from Excel: hypertension for 5 years, non-smoker, no documented cardiac disease or known allergies; symptoms progressing over 24-48 hours, oxygen saturation approximately 88%, blood pressure 160/100 mmHg and bilateral basal crackles\n- Final examination rationale from Excel: rapid initial assessment and confirmation\n\nFictitious completions (not specified in Excel): date of birth 1985-04-12, PSS identifier PSS-RAD-001, prescription and validity dates, requester, ambulatory track and routine priority; no implants, diabetes, metallic debris or renal dysfunction and no other safety concern.\nClinical context is represented by encrypted placeholders in patientCondition.text and note.text; date of birth and sex at birth remain encrypted. Placeholders are illustrative, not real encrypted patient data. Procedure coding follows Exam List processed.xlsx." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://www.riziv-inami.be/standards/fhir/ereferral/StructureDefinition/ereferral-servicerequest-diagnosticimaging" ;
         fhir:link <https://www.riziv-inami.be/standards/fhir/ereferral/StructureDefinition/ereferral-servicerequest-diagnosticimaging>
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ServiceRequest" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://www.riziv-inami.be/standards/fhir/ereferral/ServiceRequest/example-pss-radiology-scenario-02> ;
         fhir:Reference.reference [ fhir:value "ServiceRequest/example-pss-radiology-scenario-02" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "PSS radiology scenario 02" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Example of a diagnostic imaging prescription.\n\nInputs and values used in this example:\n- Patient: Ilse Vandekerk, female, 18 years old\n- Indication: persistent fever and unresolved or complicated pneumonia\n- Selected examination: chest X-ray\n- Procedure code (SNOMED): 399208008\n- Predefined examination: chest X-ray\n- Clinical context from Excel: previously diagnosed pneumonia, persistent fever despite antibiotics, continued cough, dyspnea and pleuritic chest pain; no immunodeficiency or known allergies; assess possible abscess, pleural effusion or empyema\n\nFictitious completions (not specified in Excel): date of birth 2008-04-12, PSS identifier PSS-RAD-002, prescription and validity dates, requester, ambulatory track and routine priority; not pregnant, no implants, diabetes, metallic debris or renal dysfunction and no other safety concern.\nClinical context is represented by encrypted placeholders in patientCondition.text and note.text; date of birth and sex at birth remain encrypted. Placeholders are illustrative, not real encrypted patient data. Procedure coding follows Exam List processed.xlsx." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
