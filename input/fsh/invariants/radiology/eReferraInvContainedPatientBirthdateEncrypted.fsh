Invariant: ereferral-inv-contained-patient-birthdate-encrypted
Description: "The birthDate of the contained Patient must not be sent in clear text and must be represented only by the encrypted be-ext-pseudonymized-content extension."
Severity: #error
Expression: "contained.ofType(Patient).all(birthDate.hasValue().not() and birthDate.extension.where(url = 'https://www.ehealth.fgov.be/standards/fhir/infsec/StructureDefinition/be-ext-pseudonymized-content').exists() and birthDate.extension.where(url = 'https://www.ehealth.fgov.be/standards/fhir/infsec/StructureDefinition/be-ext-pseudonymized-content').extension.where(url = 'encryptedValue').value.matches('^urn:be:fgov:pseudo-encrypted:v1:.+') and birthDate.extension.where(url = 'https://www.ehealth.fgov.be/standards/fhir/infsec/StructureDefinition/be-ext-pseudonymized-content').extension.where(url = 'marker').value = true and birthDate.extension.where(url = 'https://www.ehealth.fgov.be/standards/fhir/infsec/StructureDefinition/be-ext-pseudonymized-content').extension.where(url = 'format').value = 'encrypted' and birthDate.extension.where(url = 'https://www.ehealth.fgov.be/standards/fhir/infsec/StructureDefinition/be-ext-pseudonymized-content').extension.where(url = 'version').value.exists())"